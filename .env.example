# Yogi Tree Resort — Environment Variables
# Copy this file to .env and fill in real values before running

# ── Web App ──────────────────────────────────────────────
SITE_URL=https://www.yourdomain.com
PUBLIC_API_BASE=http://localhost:3001

# ── API Server ────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:4321

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/koko_maya

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── eZee Booking Engine ──────────────────────────────────
EZEE_API_KEY=your_ezee_api_key_here
EZEE_PROPERTY_ID=your_ezee_property_id_here
EZEE_CHAIN_ID=your_ezee_chain_id_here
EZEE_WEBHOOK_SECRET=your_ezee_webhook_hmac_secret_here

# ── Email (Postmark or AWS SES) ───────────────────────────
EMAIL_PROVIDER=postmark           # postmark | ses
EMAIL_API_KEY=your_email_api_key_here
HOTEL_EMAIL=hello@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com

# ── reCAPTCHA v3 (server-side) ───────────────────────────
RECAPTCHA_SECRET=your_recaptcha_secret_key_here

# ── Directus CMS ─────────────────────────────────────────
DIRECTUS_URL=http://localhost:8055
DIRECTUS_KEY=your_directus_access_key_here
DIRECTUS_SECRET=your_directus_secret_here
