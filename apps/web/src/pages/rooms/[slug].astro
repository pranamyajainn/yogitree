---
// apps/web/src/pages/rooms/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rooms } from '../../data/rooms';

export function getStaticPaths() {
  return rooms.map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

const { room } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HotelRoom",
  "name": room.name,
  "description": room.longDescription,
  "image": `https://www.yourdomain.com${room.image}`,
  "occupancy": {
    "@type": "QuantitativeValue",
    "value": room.maxGuests
  },
  "amenityFeature": room.amenities.map(a => ({
    "@type": "LocationFeatureSpecification",
    "name": a.label,
    "value": true
  }))
};
---

<BaseLayout 
  title={`${room.name} — Luxury Stay at Morjim Beach`}
  description={room.description}
  jsonLd={jsonLd}
>
  <article class="room-detail">
    <!-- Gallery Section -->
    <section class="room-gallery">
      <div class="container room-gallery__inner">
        <div class="gallery-main">
          <img src={room.image} 
               alt={room.name} 
               class="gallery-main__img" 
               fetchpriority="high"
               loading="eager"
               decoding="sync"
               srcset={`${room.image.replace('.jpg', '-640.jpg')} 640w, ${room.image} 1280w`}
               sizes="(max-width: 768px) 100vw, 66vw" />
        </div>
        <div class="gallery-grid">
          {room.gallery.map((img, i) => (
            <div class="gallery-item">
              <img src={img} 
                   alt={`${room.name} gallery image ${i + 1}`} 
                   class="gallery-item__img" 
                   loading="lazy" 
                   decoding="async" 
                   srcset={`${img.replace('.jpg', '-640.jpg')} 640w, ${img} 1280w`}
                   sizes="(max-width: 768px) 100vw, 33vw" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section class="section section--sand room-content">
      <div class="container room-content__inner">
        <div class="room-info">
          <div class="room-info__header">
            <p class="eyebrow">Suite Details</p>
            <h1 class="section-title">{room.name}</h1>
            <div class="room-info__meta">
               {room.highlights.map(h => <span class="badge">{h}</span>)}
            </div>
          </div>

          <div class="room-info__prose">
            <p class="section-body">{room.longDescription}</p>
          </div>

          <!-- Specs -->
          <div class="room-specs-grid">
            <div class="spec-tile">
              <span class="spec-tile__label">Room Size</span>
              <span class="spec-tile__val">{room.size} sq. ft.</span>
            </div>
            <div class="spec-tile">
              <span class="spec-tile__label">Occupancy</span>
              <span class="spec-tile__val">Up to {room.maxGuests} Guests</span>
            </div>
            <div class="spec-tile">
              <span class="spec-tile__label">Bed Selection</span>
              <span class="spec-tile__val">{room.bedType}</span>
            </div>
            <div class="spec-tile">
              <span class="spec-tile__label">View</span>
              <span class="spec-tile__val">{room.slug.includes('pool-view') ? 'Pool & Garden' : 'Morjim Sea Breeze'}</span>
            </div>
          </div>

          <!-- Amenities -->
          <div class="room-amenities">
            <h2 class="room-amenities__title">In-Room Amenities</h2>
            <ul class="amenities-list" role="list">
              {room.amenities.map(a => (
                <li class="amenity-item">
                  <span class="amenity-dot"></span>
                  <span class="amenity-label">{a.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Sidebar / Booking Card -->
        <aside class="room-sidebar">
          <div class="booking-card sticky-sidebar">
            <div class="booking-card__header">
              <span class="price-label">Starting from</span>
              <div class="price-wrap">
                <span class="price-val">₹{room.startingPrice.toLocaleString('en-IN')}</span>
                <span class="price-period">/ night</span>
              </div>
            </div>
            <div class="booking-card__body">
              <p class="booking-note">Inclusive of breakfast (CP Plan)</p>
              <ul class="booking-features" role="list">
                <li>✓ Free Cancellation (48h before)</li>
                <li>✓ Best Rate Guaranteed</li>
                <li>✓ No Booking Fees</li>
              </ul>
              <a href={`/book/?room=${room.slug}`} class="btn btn--primary btn--lg" style="width:100%;justify-content:center;">Book This Room</a>
              <p class="booking-help">Need help? <a href="/contact/">Contact us</a></p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section room-cta">
      <div class="container room-cta__inner">
        <h2 class="section-title">Escape to the Shores of Morjim</h2>
        <p class="section-body" style="margin-inline:auto;text-align:center">
          Experience the refreshing sea breeze and soulful Goan hospitality. 
          Your perfect beach retreat is just a click away.
        </p>
        <div style="display:flex;gap:var(--space-4);justify-content:center;margin-top:var(--space-8)">
           <a href="/rooms/" class="btn btn--outline btn--lg">Explore Other Rooms</a>
           <a href="/book/" class="btn btn--accent btn--lg">Check Availability</a>
        </div>
      </div>
    </section>

    <!-- Sticky Mobile CTA -->
    <div class="sticky-mobile-cta">
      <div class="sticky-mobile-cta__inner">
        <div class="sticky-mobile-cta__price">
          <span class="price-val">₹{room.startingPrice.toLocaleString('en-IN')}</span> / night
        </div>
        <a href={`/book/?room=${room.slug}`} class="btn btn--primary">Book Now</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .room-gallery {
    padding-top: var(--nav-height);
    background: var(--color-white);
  }
  .room-gallery__inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-4);
    aspect-ratio: 21/9;
  }
  .gallery-main__img, .gallery-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-grid {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .room-content__inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-16);
    align-items: start;
  }

  .room-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .room-info__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .room-info__meta {
    display: flex;
    gap: var(--space-2);
  }

  .room-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }
  .spec-tile {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background: var(--color-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-sand-dark);
  }
  .spec-tile__label {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }
  .spec-tile__val {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-charcoal);
  }

  .room-amenities__title {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-6);
  }
  .amenities-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }
  .amenity-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .amenity-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sunset);
    flex-shrink: 0;
  }

  .booking-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    border: 1px solid var(--color-sand-dark);
  }
  .sticky-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-8));
  }
  .booking-card__header {
    padding: var(--space-6);
    background: var(--color-ocean);
    color: var(--color-white);
  }
  .price-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }
  .price-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }
  .price-val {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
  }
  .price-period { font-size: var(--text-base); }

  .booking-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .booking-note {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-leaf);
    background: hsla(145, 40%, 35%, 0.1);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .booking-features {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .booking-help {
    font-size: var(--text-xs);
    text-align: center;
    color: var(--color-muted);
  }
  .booking-help a { color: var(--color-ocean); font-weight: var(--weight-medium); }

  .room-cta { text-align: center; }

  @media (max-width: 1024px) {
    .room-content__inner {
      grid-template-columns: 1fr;
    }
    .room-sidebar {
      order: -1;
    }
    .sticky-sidebar {
      position: static;
    }
    .room-gallery__inner {
      aspect-ratio: 16/9;
    }
  }

  @media (max-width: 768px) {
    .room-gallery__inner {
      grid-template-columns: 1fr;
      aspect-ratio: 4/3;
    }
    .gallery-grid {
      display: none;
    }
    .amenities-list {
      grid-template-columns: 1fr;
    }
  }

  .sticky-mobile-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-white);
    padding: var(--space-4);
    padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-sand-dark);
    box-shadow: 0 -4px 16px rgba(0,0,0,0.1);
    z-index: 100;
  }
  .sticky-mobile-cta__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .sticky-mobile-cta__price {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .sticky-mobile-cta__price .price-val {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-ocean);
  }

  @media (max-width: 1024px) {
    .sticky-mobile-cta {
      display: block;
    }
    /* Hide desktop CTA from sidebar on mobile since we have sticky */
    .room-sidebar .btn--primary {
      display: none;
    }
  }
</style>
