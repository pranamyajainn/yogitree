---
// FacilitiesSection.astro
const facilities = [
  { icon: 'film',     label: 'Open-air Movie Theatre', hours: '4:00 PM – 10:00 PM' },
  { icon: 'calendar', label: '24-hour Travel Desk',    hours: 'Always open' },
  { icon: 'car',      label: 'Car / Bike Rentals',     hours: 'On request' },
  { icon: 'star',     label: 'Concierge Service',      hours: 'Always available' },
  { icon: 'clock',    label: '24-hour Front Desk',     hours: 'Always open' },
  { icon: 'droplets', label: 'Swimming Pool',          hours: '8:00 AM – 8:00 PM' },
  { icon: 'utensils', label: 'Multi-cuisine Restaurant', hours: 'As per meal timings' },
  { icon: 'smile',    label: "Kids' Play Area",        hours: '8:00 AM – 8:00 PM' },
  { icon: 'activity', label: 'Indoor / Outdoor Games', hours: '8:00 AM – 8:00 PM' },
  { icon: 'shirt',    label: 'Laundry Service',        hours: 'Chargeable' },
  { icon: 'bell',     label: 'Room Service',           hours: '8:00 AM – 10:30 PM' },
  { icon: 'shield',   label: 'CCTV Surveillance',      hours: '24/7' },
  { icon: 'parking',  label: 'Free Parking',           hours: 'Always available' },
];

