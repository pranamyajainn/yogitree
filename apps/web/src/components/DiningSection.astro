---
// DiningSection.astro — Curry, Wok & Waves restaurant
const timings = [
  { meal: 'Breakfast', hours: '8:00 AM – 10:30 AM' },
  { meal: 'Lunch',     hours: '1:00 PM – 3:30 PM' },
  { meal: 'Dinner',    hours: '7:30 PM – 10:30 PM' },
];
---

<section class="section dining-section" id="dining" aria-labelledby="dining-title">
  <div class="container dining-inner">
    <div class="dining-image">
      <img src="/images/dining/restaurant.jpg"
           alt="Curry, Wok & Waves open-air restaurant with ocean view"
           width="640" height="480"
           loading="lazy"
           class="dining-img" />
      <div class="dining-img-badge" aria-hidden="true">
        <span>1st Floor</span>
        <span>Beach View</span>
      </div>
    </div>
    <div class="dining-content">
      <p class="eyebrow">Restaurant</p>
      <h2 class="section-title" id="dining-title">Curry, Wok &amp; Waves</h2>
      <hr class="divider" />
      <p class="section-body">
        An exquisite open-air dining space designed to delight every sense. Savour vibrant
        Indian cuisine and delicate Chinese fare — buffet-style or à la carte — while sweeping
        views of Morjim Beach and the sea breeze become part of your meal.
      </p>
      <p class="dining-capacity">
        <strong>Seats up to 40 guests</strong> — perfect for romantic dinners, family gatherings, and team lunches.
      </p>

      <div class="dining-timings" aria-label="Restaurant timings">
        <p class="dining-timings__heading">Hours (buffet availability depends on meal plan)</p>
        {timings.map(t => (
          <div class="dining-timing-row">
            <span class="dining-timing-meal">{t.meal}</span>
            <span class="dining-timing-hours">{t.hours}</span>
          </div>
        ))}
      </div>

      <div class="dining-ctas">
        <a href="/dining/menu.pdf" target="_blank" rel="noopener" class="btn btn--outline">
          View Our Menu (PDF)
        </a>
        <a href="/dining/" class="btn btn--primary">
          Dining Details
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.dining-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: center;
}
@media (max-width: 768px) {
  .dining-inner { grid-template-columns: 1fr; }
}

/* Image side */
.dining-image { position: relative; }
.dining-img {
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
}
.dining-img-badge {
  position: absolute;
  bottom: var(--space-6);
  right: var(--space-6);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-2);
}
.dining-img-badge span {
  background: var(--color-ocean);
  color: var(--color-white);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
}

/* Content side */
.dining-capacity {
  font-size: var(--text-sm);
  color: var(--color-muted);
  margin: var(--space-4) 0 var(--space-6);
}
.dining-timings {
  background: var(--color-ocean-light);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-6);
  margin-bottom: var(--space-8);
}
.dining-timings__heading {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-ocean);
  margin-bottom: var(--space-4);
}
.dining-timing-row {
  display: flex;
  justify-content: space-between;
  padding: var(--space-2) 0;
  border-bottom: 1px solid hsl(200 55% 26% / 0.1);
  font-size: var(--text-sm);
}
.dining-timing-row:last-child { border-bottom: none; }
.dining-timing-meal { font-weight: var(--weight-medium); color: var(--color-charcoal); }
.dining-timing-hours { color: var(--color-muted); }
.dining-ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; }
</style>
