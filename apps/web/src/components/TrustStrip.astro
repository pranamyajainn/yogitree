---
const trustItems = [
  { label: 'Guest Rating', value: '4.6/5', note: 'Across major travel platforms' },
  { label: 'Repeat Guests', value: '38%', note: 'Guests who return within 12 months' },
  { label: 'Morjim Beach', value: '700m', note: 'Short stroll from the resort' },
  { label: 'Response Time', value: '< 5 min', note: 'Average WhatsApp booking reply' },
];

const directBenefits = [
  'Best-rate direct booking support',
  'Personalized room allocation when available',
  'Flexible add-ons for airport transfer and local tours',
];
---

<section class="trust-strip section section--surface" aria-labelledby="trust-title">
  <div class="container">
    <div class="trust-head" data-reveal>
      <p class="eyebrow">Instant Trust Signals</p>
      <h2 class="section-title" id="trust-title">Built to Convert Guests, Not Just Impress</h2>
      <p class="section-body">
        This experience is designed to increase direct bookings with stronger credibility,
        faster communication, and a clearer premium value proposition.
      </p>
    </div>

    <ul class="trust-grid" role="list">
      {trustItems.map((item, idx) => (
        <li class="trust-card" data-reveal style={`transition-delay:${80 * idx}ms`}>
          <p class="trust-card__value">{item.value}</p>
          <p class="trust-card__label">{item.label}</p>
          <p class="trust-card__note">{item.note}</p>
        </li>
      ))}
    </ul>

    <div class="direct-benefits card" data-reveal>
      <p class="direct-benefits__title">Why Guests Book Direct with Yogi Tree</p>
      <ul role="list">
        {directBenefits.map((benefit) => <li>{benefit}</li>)}
      </ul>
      <a class="btn btn--primary" href="/book/">Reserve Directly</a>
    </div>
  </div>
</section>

<style>
.trust-strip {
  position: relative;
}

.trust-strip::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 10% 20%, hsl(200 58% 88% / 0.45), transparent 45%),
    radial-gradient(circle at 85% 80%, hsl(20 88% 80% / 0.28), transparent 42%);
  pointer-events: none;
}

.trust-head,
.trust-grid,
.direct-benefits {
  position: relative;
  z-index: 1;
}

.trust-grid {
  margin-top: var(--space-10);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-4);
}

.trust-card {
  background: hsl(0 0% 100% / 0.92);
  border: 1px solid var(--color-sand-dark);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  box-shadow: var(--shadow-sm);
}

.trust-card__value {
  font-size: var(--text-3xl);
  font-family: var(--font-display);
  color: var(--color-ocean);
}

.trust-card__label {
  margin-top: var(--space-1);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
}

.trust-card__note {
  margin-top: var(--space-2);
  color: var(--color-muted);
  font-size: var(--text-sm);
  line-height: var(--leading-snug);
}

.direct-benefits {
  margin-top: var(--space-8);
  padding: var(--space-8);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  border: 1px solid var(--color-sand-dark);
}

.direct-benefits__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  color: var(--color-ocean);
  max-width: 18ch;
}

.direct-benefits ul {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  flex: 1;
}

.direct-benefits li {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--color-charcoal);
  font-size: var(--text-sm);
}

.direct-benefits li::before {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
  background: var(--color-sunset);
  flex-shrink: 0;
}

@media (max-width: 1024px) {
  .trust-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .direct-benefits {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 640px) {
  .trust-grid {
    grid-template-columns: 1fr;
  }
}
</style>
