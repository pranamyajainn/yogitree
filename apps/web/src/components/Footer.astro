---
// Footer.astro
---

<footer class="footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Yogi Tree Resort home">
        <img
          src="/images/logo/yogitree-logo-real.png"
          alt="Yogi Tree Resort"
          class="footer-logo__img"
          width="128"
          height="36"
        />
        <span class="footer-logo__name">Yogi Tree Resort</span>
      </a>
      <p class="footer-tagline">Steps from Morjim Beach — where the sea breeze greets your morning.</p>
      <address class="footer-address">
        <p>[Street Address], Morjim, Pernem, Goa – 403512</p>
        <p><a href="tel:+917030901111">+91 7030901111</a></p>
        <p><a href="mailto:contactus@yogitree.co.in">contactus@yogitree.co.in</a></p>
      </address>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <div class="footer-col">
        <h3 class="footer-col__title">Explore</h3>
        <ul role="list">
          <li><a href="/rooms/">Rooms</a></li>
          <li><a href="/dining/">Dining</a></li>
          <li><a href="/#facilities">Facilities</a></li>
          <li><a href="/gallery/">Gallery</a></li>
          <li><a href="/offers/">Offers</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-col__title">Info</h3>
        <ul role="list">
          <li><a href="/contact/">Location & Contact</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms & Conditions</a></li>
          <li><a href="/book/">Manage Booking</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3 class="footer-col__title">Stay Connected</h3>
        <p class="footer-social-label">Follow us for travel inspiration</p>
        <div class="footer-social">
          <a href="#" aria-label="Instagram" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="Facebook" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
        <div class="footer-book-cta">
          <a href="/book/" class="btn btn--accent">Book Direct — Best Rate</a>
        </div>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {new Date().getFullYear()} Yogi Tree Resort. All rights reserved.</p>
      <p>Website by <a href="#">[Your Agency]</a></p>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--color-charcoal);
  color: hsl(0 0% 100% / 0.75);
  font-size: var(--text-sm);
}
.footer-inner {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: var(--space-16);
  padding-block: var(--space-16) var(--space-12);
}
@media (max-width: 768px) {
  .footer-inner { grid-template-columns: 1fr; gap: var(--space-10); }
}

/* Brand */
.footer-logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  text-decoration: none;
  margin-bottom: var(--space-4);
}
.footer-logo__img {
  width: 128px;
  height: 36px;
  object-fit: contain;
}
.footer-logo__name {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  color: var(--color-white);
  font-weight: var(--weight-semibold);
}
.footer-tagline {
  line-height: var(--leading-loose);
  margin-bottom: var(--space-6);
  max-width: 36ch;
}
.footer-address {
  font-style: normal;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.footer-address a {
  color: inherit;
  text-decoration: none;
  transition: color var(--dur-fast);
}
.footer-address a:hover { color: var(--color-white); }

/* Nav columns */
.footer-nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-8);
}
@media (max-width: 640px) {
  .footer-nav { grid-template-columns: repeat(2, 1fr); }
}
.footer-col__title {
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-sand-dark);
  margin-bottom: var(--space-4);
}
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
.footer-col a {
  text-decoration: none;
  color: hsl(0 0% 100% / 0.65);
  transition: color var(--dur-fast);
}
.footer-col a:hover { color: var(--color-white); }

/* Social */
.footer-social-label { margin-bottom: var(--space-3); }
.footer-social { display: flex; gap: var(--space-3); margin-bottom: var(--space-6); }
.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px; height: 40px;
  border-radius: var(--radius-full);
  background: hsl(0 0% 100% / 0.1);
  color: hsl(0 0% 100% / 0.7);
  text-decoration: none;
  transition: background var(--dur-fast), color var(--dur-fast);
}
.social-link:hover { background: var(--color-ocean); color: var(--color-white); }

/* Bottom bar */
.footer-bottom {
  border-top: 1px solid hsl(0 0% 100% / 0.1);
  padding-block: var(--space-6);
}
.footer-bottom-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.footer-bottom a { color: inherit; }
.footer-bottom a:hover { color: var(--color-white); }
</style>
