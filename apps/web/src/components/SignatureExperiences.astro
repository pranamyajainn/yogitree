---
const moments = [
  { title: 'Golden-Hour Pool Deck', image: '/images/hero/hero-2.jpg', text: 'Evening light, curated music, and open-sky relaxation.' },
  { title: 'Balcony Mornings', image: '/images/rooms/deluxe-balcony.jpg', text: 'Quiet private corners with sea air and coffee service.' },
  { title: 'Curry, Wok & Waves', image: '/images/dining/restaurant.jpg', text: 'A mixed menu of Goan comfort food and global favorites.' },
];
---

<section class="section experience-showcase" aria-labelledby="experience-title">
  <div class="container experience-shell">
    <div class="experience-copy" data-reveal="left">
      <p class="eyebrow">Signature Moments</p>
      <h2 class="section-title" id="experience-title">A Boutique Stay Designed for Memory-Making</h2>
      <p class="section-body">
        From the first impression to checkout, each touchpoint is framed for a premium
        guest story. This section is built to make your video demo emotionally memorable.
      </p>
      <a href="/gallery/" class="btn btn--outline">Open Full Gallery</a>
    </div>

    <div class="experience-grid" data-reveal="right">
      {moments.map((moment, idx) => (
        <article class:list={['experience-card', { 'experience-card--feature': idx === 0 }]}>
          <img src={moment.image} alt={moment.title} loading="lazy" />
          <div class="experience-card__overlay">
            <h3>{moment.title}</h3>
            <p>{moment.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.experience-showcase {
  background: linear-gradient(135deg, hsl(40 35% 92%) 0%, hsl(40 55% 96%) 55%, hsl(200 45% 94%) 100%);
}

.experience-shell {
  display: grid;
  grid-template-columns: 0.95fr 1.35fr;
  gap: var(--space-10);
  align-items: center;
}

.experience-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-4);
}

.experience-card {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  min-height: 250px;
  box-shadow: var(--shadow-md);
  isolation: isolate;
}

.experience-card--feature {
  grid-column: span 2;
  min-height: 340px;
}

.experience-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 550ms var(--ease);
}

.experience-card__overlay {
  position: absolute;
  inset: auto 0 0;
  padding: var(--space-6);
  background: linear-gradient(to top, hsl(222 14% 10% / 0.75), hsl(222 14% 10% / 0.05));
  color: var(--color-white);
}

.experience-card__overlay h3 {
  color: var(--color-white);
  font-size: var(--text-2xl);
}

.experience-card__overlay p {
  margin-top: var(--space-2);
  color: hsl(0 0% 100% / 0.86);
  font-size: var(--text-sm);
}

.experience-card:hover img {
  transform: scale(1.06);
}

@media (max-width: 980px) {
  .experience-shell {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .experience-grid {
    grid-template-columns: 1fr;
  }
  .experience-card--feature {
    grid-column: span 1;
  }
}
</style>
