---
// BookingBar.astro — Persistent availability search bar
---

<section class="booking-bar-section" aria-label="Availability search">
  <div class="booking-bar container" id="booking-bar">
    <form class="booking-form" id="booking-form" action="/book/" method="get"
          aria-label="Check room availability">
      <fieldset class="booking-fields">
        <legend class="sr-only">Search dates and guests</legend>

        <div class="booking-field">
          <label for="check-in" class="booking-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Check-in
          </label>
          <input type="date" id="check-in" name="checkin" class="booking-input" required
                 aria-required="true" aria-describedby="checkin-desc" />
          <span id="checkin-desc" class="sr-only">Enter your check-in date</span>
        </div>

        <div class="booking-divider" aria-hidden="true">→</div>

        <div class="booking-field">
          <label for="check-out" class="booking-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Check-out
          </label>
          <input type="date" id="check-out" name="checkout" class="booking-input" required
                 aria-required="true" aria-describedby="checkout-desc" />
          <span id="checkout-desc" class="sr-only">Enter your check-out date</span>
        </div>

        <div class="booking-field">
          <label for="guests" class="booking-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Guests
          </label>
          <select id="guests" name="adults" class="booking-input" aria-label="Number of adult guests">
            <option value="1">1 Adult</option>
            <option value="2" selected>2 Adults</option>
            <option value="3">3 Adults</option>
            <option value="4">4 Adults</option>
            <option value="5">5 Adults</option>
          </select>
        </div>

        <div class="booking-field">
          <label for="promo" class="booking-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            Promo Code
          </label>
          <input type="text" id="promo" name="promo" class="booking-input"
                 placeholder="Optional" autocomplete="off"
                 aria-label="Promotional discount code" />
        </div>

        <button type="submit" class="btn btn--accent btn--lg booking-submit">
          Check Availability
        </button>
      </fieldset>
    </form>
  </div>
</section>

<!-- Sticky mobile CTA -->
<div class="sticky-cta" id="sticky-cta" aria-label="Quick booking">
  <a href="/book/" class="btn btn--accent" style="flex:1;justify-content:center;">
    Book Now — Best Rate
  </a>
</div>

<style>
.booking-bar-section {
  position: relative;
  z-index: 10;
  margin-top: -50px;
}
.booking-bar {
  background: var(--color-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xl);
  padding: var(--space-6) var(--space-8);
  border: 1px solid var(--color-sand-dark);
}
.booking-form { width: 100%; }
.booking-fields {
  border: none;
  padding: 0;
  display: flex;
  gap: var(--space-4);
  align-items: flex-end;
  flex-wrap: wrap;
}
.booking-field {
  flex: 1;
  min-width: 150px;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.booking-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted);
}
.booking-input {
  padding: var(--space-3) var(--space-4);
  border: 1.5px solid var(--color-sand-dark);
  border-radius: var(--radius-md);
  font-size: var(--text-base);
  color: var(--color-charcoal);
  background: var(--color-surface);
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  width: 100%;
}
.booking-input:focus {
  outline: none;
  border-color: var(--color-ocean);
  box-shadow: 0 0 0 3px hsl(200 55% 26% / 0.12);
}
.booking-divider {
  font-size: var(--text-xl);
  color: var(--color-muted);
  padding-bottom: var(--space-3);
  align-self: flex-end;
}
.booking-submit { flex-shrink: 0; white-space: nowrap; }

/* Sticky mobile CTA */
.sticky-cta {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 900;
  padding: var(--space-3) var(--container-pad);
  background: var(--color-white);
  box-shadow: 0 -4px 20px hsl(0 0% 0% / 0.12);
  gap: var(--space-3);
}

@media (max-width: 768px) {
  .booking-fields { flex-direction: column; }
  .booking-divider { display: none; }
  .sticky-cta { display: flex; }
  body { padding-bottom: calc(var(--sticky-cta-h) + var(--space-4)); }
}
</style>

<script>
  // Set min date for check-in to today
  const today = new Date().toISOString().split('T')[0];
  const checkIn  = document.getElementById('check-in')  as HTMLInputElement;
  const checkOut = document.getElementById('check-out') as HTMLInputElement;
  checkIn.min  = today;
  checkOut.min = today;

  // Auto-set check-out to check-in + 1 when check-in is chosen
  checkIn.addEventListener('change', () => {
    if (!checkOut.value || checkOut.value <= checkIn.value) {
      const next = new Date(checkIn.value);
      next.setDate(next.getDate() + 1);
      checkOut.min   = next.toISOString().split('T')[0];
      checkOut.value = next.toISOString().split('T')[0];
    } else {
      checkOut.min = checkIn.value;
    }
  });

  // Hide sticky CTA when booking bar is visible (IntersectionObserver)
  const bar    = document.getElementById('booking-bar') as HTMLElement;
  const sticky = document.getElementById('sticky-cta') as HTMLElement;
  const obs = new IntersectionObserver(
    ([entry]) => { sticky.style.display = entry.isIntersecting ? 'none' : 'flex'; },
    { threshold: 0.5 }
  );
  obs.observe(bar);
</script>
