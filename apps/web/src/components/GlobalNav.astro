---
// GlobalNav.astro — Sticky navigation with transparent-to-solid scroll effect
const navLinks = [
  { label: 'Home',       href: '/' },
  { label: 'Rooms',      href: '/rooms/' },
  { label: 'Dining',     href: '/dining/' },
  { label: 'Facilities', href: '/#facilities' },
  { label: 'Offers',     href: '/offers/' },
  { label: 'Gallery',    href: '/gallery/' },
  { label: 'Contact',    href: '/contact/' },
];
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
---

<header class:list={['nav-header', { 'nav-header--solid': !isHome }]} id="site-header" role="banner">
  <nav class="nav-inner container" aria-label="Primary navigation">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Yogi Tree Resort — Home">
      <span class="nav-logo__mark">
        <img
          src="/images/logo/yogitree-logo-real.png"
          alt="Yogi Tree Resort"
          class="nav-logo__img"
          width="136"
          height="40"
        />
      </span>
      <span class="nav-logo__text">
        <span class="nav-logo__name">Yogi Tree</span>
        <span class="nav-logo__sub">Resort, Morjim</span>
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      {navLinks.map(link => (
        <li>
          <a href={link.href}
             class:list={['nav-link', { 'nav-link--active': currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
             aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Book Now CTA -->
    <a href="/book/" class="btn btn--accent nav-book-btn">
      Book Now
    </a>

    <!-- Mobile hamburger -->
    <button class="nav-hamburger" id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation menu">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu" hidden>
    <ul class="mobile-links" role="list">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="mobile-link"
             aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/book/" class="btn btn--accent btn--lg" style="width:100%;justify-content:center;margin-top:var(--space-4)">
          Book Now
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
.nav-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: transparent;
  transition: background var(--dur-normal) var(--ease),
              box-shadow var(--dur-normal) var(--ease),
              backdrop-filter var(--dur-normal) var(--ease);
}
.nav-header.scrolled {
  background: hsl(0 0% 100% / 0.92);
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow-sm);
}
.nav-header--solid {
  background: hsl(0 0% 100% / 0.92);
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow-sm);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--nav-height);
  gap: var(--space-6);
}

/* Logo */
.nav-logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  text-decoration: none;
  flex-shrink: 0;
}
.nav-logo__mark {
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  background: hsl(0 0% 100% / 0.95);
  box-shadow: var(--shadow-xs);
}
.nav-logo__img {
  width: 136px;
  height: 40px;
  object-fit: contain;
}
.nav-logo__text {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}
.nav-logo__name {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: var(--weight-semibold);
  color: var(--color-white);
  transition: color var(--dur-fast);
}
.nav-logo__sub {
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: hsl(0 0% 100% / 0.7);
  transition: color var(--dur-fast);
}
.nav-header--solid .nav-logo__name { color: var(--color-ocean); }
.nav-header--solid .nav-logo__sub  { color: var(--color-muted); }
.nav-header.scrolled .nav-logo__name { color: var(--color-ocean); }
.nav-header.scrolled .nav-logo__sub  { color: var(--color-muted); }

/* Desktop links */
.nav-links {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  list-style: none;
  margin: 0;
  padding: 0;
}
.nav-link {
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  text-decoration: none;
  color: var(--color-white);
  transition: background var(--dur-fast), color var(--dur-fast);
  white-space: nowrap;
}
.nav-link:hover { background: hsl(0 0% 100% / 0.15); }
.nav-link--active { background: hsl(0 0% 100% / 0.2); }
.nav-header--solid .nav-link { color: var(--color-charcoal); }
.nav-header--solid .nav-link:hover { background: var(--color-ocean-light); color: var(--color-ocean); }
.nav-header--solid .nav-link--active { background: var(--color-ocean-light); color: var(--color-ocean); }
.nav-header.scrolled .nav-link { color: var(--color-charcoal); }
.nav-header.scrolled .nav-link:hover { background: var(--color-ocean-light); color: var(--color-ocean); }
.nav-header.scrolled .nav-link--active { background: var(--color-ocean-light); color: var(--color-ocean); }

/* Book button */
.nav-book-btn {
  flex-shrink: 0;
  font-size: var(--text-sm);
  padding: var(--space-2) var(--space-5);
}

/* Hamburger */
.nav-hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 40px;
  height: 40px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: var(--space-2);
  border-radius: var(--radius-sm);
}
.hamburger-bar {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--color-white);
  border-radius: var(--radius-full);
  transition: transform var(--dur-normal) var(--ease), opacity var(--dur-normal);
}
.nav-header--solid .hamburger-bar { background: var(--color-charcoal); }
.nav-header.scrolled .hamburger-bar { background: var(--color-charcoal); }
.nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(2) { opacity: 0; }
.nav-hamburger[aria-expanded="true"] .hamburger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Mobile menu */
.mobile-menu {
  position: fixed;
  inset: var(--nav-height) 0 0 0;
  background: var(--color-white);
  padding: var(--space-8) var(--container-pad);
  overflow-y: auto;
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity var(--dur-normal) var(--ease), transform var(--dur-normal) var(--ease);
  box-shadow: var(--shadow-lg);
}
.mobile-menu:not([hidden]) { opacity: 1; transform: translateY(0); }
.mobile-links { display: flex; flex-direction: column; gap: var(--space-2); }
.mobile-link {
  display: block;
  padding: var(--space-4) var(--space-4);
  font-size: var(--text-lg);
  font-weight: var(--weight-medium);
  color: var(--color-charcoal);
  text-decoration: none;
  border-radius: var(--radius-md);
  transition: background var(--dur-fast);
}
.mobile-link:hover,
.mobile-link[aria-current="page"] {
  background: var(--color-ocean-light);
  color: var(--color-ocean);
}

@media (max-width: 900px) {
  .nav-links, .nav-book-btn { display: none !important; }
  .nav-hamburger { display: flex !important; }
}
</style>

<script>
  const header  = document.getElementById('site-header') as HTMLElement;
  const toggle  = document.getElementById('nav-toggle') as HTMLButtonElement;
  const menu    = document.getElementById('mobile-menu') as HTMLElement;

  // Scroll effect
  const onScroll = () => {
    header.classList.toggle('scrolled', window.scrollY > 40);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Close on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900 && !menu.hidden) {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  });

  // Close on link click
  menu.querySelectorAll('.mobile-link, .btn').forEach(el => {
    el.addEventListener('click', () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
</script>
