---
// HeroCarousel.astro — Full-bleed autoplay hero with blur-up background
export interface Props {
  slides: { image: string; alt: string; tagline?: string }[];
}
const { slides } = Astro.props;
---

<section class="hero" aria-label="Resort hero images" role="region">
  <div class="hero-slides" id="hero-slides">
    {slides.map((slide, i) => (
      <div class:list={['hero-slide', { 'hero-slide--active': i === 0 }]}
           aria-hidden={i !== 0}>
        <img src={slide.image} 
             alt={slide.alt} 
             class="hero-slide__image" 
             loading={i === 0 ? "eager" : "lazy"} 
             fetchpriority={i === 0 ? "high" : "auto"} 
             decoding={i === 0 ? "sync" : "async"}
             srcset={`${slide.image.replace('.jpg', '-640.jpg')} 640w, ${slide.image} 1280w`}
             sizes="100vw"
        />
        <div class="hero-slide__overlay" aria-hidden="true"></div>
      </div>
    ))}
  </div>

  <!-- Hero content -->
  <div class="hero-content container">
    <p class="eyebrow hero-eyebrow">Morjim, North Goa</p>
    <h1 class="hero-title">
      Where the Sea<br/>Breeze Becomes<br/>Your Morning.
    </h1>
    <p class="hero-tagline">
      A boutique beach resort steps from Morjim — where sun-soaked<br class="br-desktop"/>
      balconies, pool-facing rooms, and curated Goan experiences await.
    </p>
    <div class="hero-ctas">
      <a href="/book/" class="btn btn--accent btn--lg">Check Availability</a>
      <a href="/rooms/" class="btn btn--outline-white btn--lg">Explore Rooms</a>
    </div>
  </div>

  <!-- Dots -->
  <div class="hero-dots" role="tablist" aria-label="Carousel slide controls">
    {slides.map((_, i) => (
      <button class:list={['hero-dot', { 'hero-dot--active': i === 0 }]}
              role="tab"
              aria-selected={i === 0}
              aria-label={`Slide ${i + 1}`}
              data-index={i}>
      </button>
    ))}
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <svg width="12" height="20" viewBox="0 0 12 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 0v20M1 15l5 5 5-5"/>
    </svg>
  </div>
</section>

<style>
.hero {
  position: relative;
  height: 100svh;
  min-height: 600px;
  max-height: 900px;
  overflow: hidden;
  display: flex;
  align-items: center;
}

/* Slides */
.hero-slides {
  position: absolute;
  inset: 0;
}
.hero-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 1.2s var(--ease), transform 8s linear;
  transform: scale(1.05);
}
.hero-slide__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}
.hero-slide--active {
  opacity: 1;
  transform: scale(1);
}
.hero-slide__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    hsl(222 14% 10% / 0.72) 0%,
    hsl(222 14% 10% / 0.48) 45%,
    hsl(222 14% 10% / 0.74) 100%
  );
}

/* Content */
.hero-content {
  position: relative;
  z-index: 2;
  color: var(--color-white);
  padding-top: var(--nav-height);
  max-width: 740px;
}
.hero-eyebrow {
  color: hsl(0 0% 100% / 0.8);
  margin-bottom: var(--space-4);
  text-shadow: 0 2px 12px hsl(0 0% 0% / 0.45);
}
.hero-title {
  font-family: var(--font-display);
  font-size: var(--text-5xl);
  font-weight: var(--weight-semibold);
  color: var(--color-white);
  line-height: 1.1;
  margin-bottom: var(--space-6);
  text-shadow: 0 2px 20px hsl(0 0% 0% / 0.3);
}
.hero-tagline {
  font-size: var(--text-lg);
  color: hsl(0 0% 100% / 0.85);
  line-height: var(--leading-loose);
  margin-bottom: var(--space-8);
  max-width: 50ch;
  text-shadow: 0 2px 14px hsl(0 0% 0% / 0.5);
}
.hero-ctas {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.br-desktop { display: block; }
@media (max-width: 640px) { .br-desktop { display: none; } }

/* Dots */
.hero-dots {
  position: absolute;
  bottom: var(--space-8);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: var(--space-3);
  z-index: 3;
}
.hero-dot {
  width: 8px; height: 8px;
  border-radius: var(--radius-full);
  background: hsl(0 0% 100% / 0.4);
  border: none;
  cursor: pointer;
  transition: background var(--dur-normal), width var(--dur-normal);
  padding: 0;
}
.hero-dot--active {
  width: 28px;
  background: var(--color-white);
}

/* Scroll indicator */
.hero-scroll {
  position: absolute;
  bottom: var(--space-8);
  right: var(--container-pad);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: hsl(0 0% 100% / 0.6);
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  z-index: 3;
  animation: bounce-scroll 2.5s ease-in-out infinite;
}
@keyframes bounce-scroll {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

@media (max-width: 640px) {
  .hero-scroll { display: none; }
  .hero-title { font-size: var(--text-4xl); }
}
</style>

<script>
  const slides = Array.from(document.querySelectorAll('.hero-slide')) as HTMLElement[];
  const dots   = Array.from(document.querySelectorAll('.hero-dot')) as HTMLButtonElement[];
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(n: number) {
    slides[current].classList.remove('hero-slide--active');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('hero-dot--active');
    dots[current].setAttribute('aria-selected', 'false');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('hero-slide--active');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('hero-dot--active');
    dots[current].setAttribute('aria-selected', 'true');
  }

  function startAuto() {
    timer = setInterval(() => goTo(current + 1), 5500);
  }
  function stopAuto() { clearInterval(timer); }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { stopAuto(); goTo(i); startAuto(); });
  });

  // Pause on hover / focus
  const hero = document.querySelector('.hero') as HTMLElement;
  hero.addEventListener('mouseenter', stopAuto);
  hero.addEventListener('mouseleave', startAuto);
  hero.addEventListener('focusin',    stopAuto);
  hero.addEventListener('focusout',   startAuto);

  // Touch / swipe
  let startX = 0;
  hero.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  hero.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) { stopAuto(); goTo(dx < 0 ? current + 1 : current - 1); startAuto(); }
  });

  // Respect reduced-motion
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    startAuto();
  }
</script>
