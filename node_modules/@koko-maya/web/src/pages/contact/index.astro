---
// apps/web/src/pages/contact/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us — Get in Touch | Yogi Tree Resort" 
  description="Contact Yogi Tree Resort for bookings, group enquiries, or general questions. We are located near Morjim Beach, North Goa."
>
  <!-- Hero Section -->
  <section class="contact-hero">
    <div class="contact-hero__bg" style="background-image: url('/images/hero/contact-banner.jpg')"></div>
    <div class="contact-hero__overlay"></div>
    <div class="container contact-hero__content">
       <p class="eyebrow" style="color:var(--color-sand)">We're Here for You</p>
       <h1 class="hero-title" style="font-size: var(--text-4xl);">Contact Us</h1>
    </div>
  </section>

  <!-- Contact Grid -->
  <section class="section section--sand p-contact">
    <div class="container contact-grid">
      <!-- Info Column -->
      <div class="contact-info">
        <header class="section-header">
          <h2 class="section-title">Reach Out Today</h2>
          <p class="section-body">
            Have a question about our rooms or planning a special trip to Morjim? 
            Drop us a message or choose your preferred way to connect.
          </p>
        </header>

        <div class="info-blocks">
          <div class="info-block">
            <h3 class="info-block__title">Our Location</h3>
            <p class="info-block__text">
              Yogi Tree Resort,<br />
              Morjim Beach Road, Morjim,<br />
              North Goa, Goa 403512, India
            </p>
          </div>

          <div class="info-block">
            <h3 class="info-block__title">Reservations</h3>
            <p class="info-block__text">
              Phone: <a href="tel:+911234567890">+91 12345 67890</a><br />
              Email: <a href="mailto:reservations@kokomaya.com">reservations@kokomaya.com</a>
            </p>
          </div>

          <div class="info-block">
            <h3 class="info-block__title">General Enquiries</h3>
            <p class="info-block__text">
              Email: <a href="mailto:hello@kokomaya.com">hello@kokomaya.com</a>
            </p>
          </div>
        </div>

        <div class="contact-map-wrap card">
           <!-- Placeholder for Google Maps Embed -->
           <div class="map-placeholder">
             <span class="map-label">Google Maps View</span>
             <p>700m from Morjim Beach</p>
           </div>
        </div>
      </div>

      <!-- Form Column -->
      <div class="contact-form-wrap card">
        <form id="contact-form" class="c-form">
          <h3 class="c-form__title">Send a Message</h3>
          
          <div class="form-group">
            <label for="c-name">Your Name *</label>
            <input type="text" id="c-name" name="name" required placeholder="John Doe" class="form-control" />
          </div>

          <div class="form-group-row">
            <div class="form-group">
              <label for="c-email">Email Address *</label>
              <input type="email" id="c-email" name="email" required placeholder="john@example.com" class="form-control" />
            </div>
            <div class="form-group">
              <label for="c-phone">Phone Number</label>
              <input type="tel" id="c-phone" name="phone" placeholder="+91 00000 00000" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label for="c-subject">Subject</label>
            <select id="c-subject" name="subject" class="form-control">
              <option value="General Enquiry">General Enquiry</option>
              <option value="Room Booking">Room Booking</option>
              <option value="Group / Event">Group / Event Quote</option>
              <option value="Feedback">Feedback</option>
            </select>
          </div>

          <div class="form-group">
            <label for="c-message">How can we help? *</label>
            <textarea id="c-message" name="message" rows="5" required placeholder="Tell us about your requirements..." class="form-control"></textarea>
          </div>

          <!-- Honeypot -->
          <div style="display:none">
            <label>Leave this field empty</label>
            <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn--primary btn--lg" style="width:100%; justify-content:center;">Send Enquiry</button>
          
          <div id="form-feedback" class="form-feedback"></div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      feedback.textContent = 'Sending your message...';
      feedback.className = 'form-feedback form-feedback--info';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          feedback.textContent = 'Thank you! Your message has been sent successfully. We will get back to you soon.';
          feedback.className = 'form-feedback form-feedback--success';
          form.reset();
        } else {
          throw new Error('Failed to send message.');
        }
      } catch (err) {
        feedback.textContent = 'Oops! Something went wrong. Please try again or call us directly.';
        feedback.className = 'form-feedback form-feedback--error';
      }
    });
  }
</script>

<style>
  .contact-hero {
    position: relative;
    height: 35vh;
    min-height: 250px;
    display: flex;
    align-items: center;
    color: white;
    overflow: hidden;
  }
  .contact-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .contact-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.5));
  }
  .contact-hero__content { position: relative; z-index: 2; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-16);
    margin-top: var(--space-8);
    align-items: start;
  }

  .contact-info { display: flex; flex-direction: column; gap: var(--space-10); }

  .info-blocks { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
  .info-block__title { font-size: var(--text-base); font-weight: var(--weight-bold); margin-bottom: var(--space-2); color: var(--color-charcoal); }
  .info-block__text { font-size: var(--text-base); color: var(--color-muted); line-height: var(--leading-loose); }
  .info-block__text a { color: var(--color-ocean); font-weight: var(--weight-medium); }

  .contact-map-wrap { height: 300px; overflow: hidden; }
  .map-placeholder {
    height: 100%;
    background: var(--color-sand-dark);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
  }
  .map-label { font-size: var(--text-lg); font-weight: var(--weight-semibold); margin-bottom: var(--space-2); }

  .contact-form-wrap { padding: var(--space-10); background: var(--color-white); }
  .c-form { display: flex; flex-direction: column; gap: var(--space-6); }
  .c-form__title { font-size: var(--text-xl); font-weight: var(--weight-bold); }

  .form-group-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }

  .form-feedback {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    text-align: center;
    display: none;
  }
  .form-feedback:not(:empty) { display: block; }
  .form-feedback--success { background: hsla(145, 40%, 35%, 0.1); color: var(--color-leaf); border: 1px solid var(--color-leaf); }
  .form-feedback--error { background: hsla(0, 80%, 55%, 0.1); color: var(--color-sunset); border: 1px solid var(--color-sunset); }
  .form-feedback--info { background: hsla(200, 55%, 28%, 0.1); color: var(--color-ocean); border: 1px solid var(--color-ocean); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .form-group-row { grid-template-columns: 1fr; }
    .contact-form-wrap { padding: var(--space-6); }
  }
</style>
